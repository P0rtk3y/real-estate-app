# ── BaoScout Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in your keys.
# All keys have free tiers that cover normal usage.

# ── AI Insights (required for live Bao scout reports) ───────────────────────
# Sign up: https://console.anthropic.com/
# Free tier: $5 credit on signup
ANTHROPIC_API_KEY=

# ── Weather — OpenWeatherMap (works globally) ────────────────────────────────
# Sign up: https://openweathermap.org/api → "Current Weather Data" free plan
# Free tier: 1,000 calls/day — more than enough
OPENWEATHER_API_KEY=

# ── Events — Ticketmaster (US / EU / AU / CA) ───────────────────────────────
# Sign up: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
# Free tier: 5,000 calls/day
TICKETMASTER_API_KEY=

# ── Events — Eventbrite (global fallback for Asia, Eastern Europe, LatAm) ───
# Sign up: https://www.eventbrite.com/platform/api → create app → copy Private Token
# Free tier: unlimited public event reads
EVENTBRITE_API_KEY=

# ── Food — Yelp Fusion (strong US / UK / AU coverage) ───────────────────────
# Sign up: https://fusion.yelp.com/ → Create App
# Free tier: 500 calls/day
YELP_API_KEY=

# ── Food — Foursquare Places v3 (global fallback — Asia, Balkans, MENA) ─────
# Sign up: https://foursquare.com/developers/signup → create project → API Keys
# Free tier: 1,000 calls/day
FOURSQUARE_API_KEY=

# ── Listings — RapidAPI (one key covers Realtor.com + Idealista) ─────────────
# Sign up: https://rapidapi.com/auth/sign-up
# Then subscribe to:
#   • Realtor.com (US listings): https://rapidapi.com/letscrape-6bRBa3QguO5/api/realtor-com4
#   • Idealista (Italy/Spain/Portugal): https://rapidapi.com/idealista/api/idealista2
# Free tier: 100-500 calls/month per API
RAPIDAPI_KEY=
# Default host (Realtor.com for US cities). Idealista is auto-selected for EU cities.
RAPIDAPI_HOST=realtor-com4.p.rapidapi.com
